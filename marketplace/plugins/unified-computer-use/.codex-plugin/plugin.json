{
  "version": "1.2.5",
  "name": "unified-computer-use",
  "description": "App-managed Browser and macOS Computer Use runtime with operator consent preauthorization and native policy checks retained.",
  "mcpServers": "./.mcp.json",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/bin/cat \"${PLUGIN_ROOT}/agent-instructions.md\"",
              "timeout": 3,
              "additionalContextLimit": 1000
            }
          ]
        }
      ],
      "SubagentStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/bin/cat \"${PLUGIN_ROOT}/agent-instructions.md\"",
              "timeout": 3,
              "additionalContextLimit": 1000
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "autonomous_cua_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "SubagentStop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "autonomous_cua_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${agent_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "mcp_tool",
              "server": "autonomous_cua_repl",
              "tool": "turn_ended",
              "input": {
                "hook_event_name": "${hook_event_name}",
                "session_id": "${session_id}",
                "turn_id": "${turn_id}"
              }
            }
          ]
        }
      ]
    }
  }
}
